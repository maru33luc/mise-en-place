{
  "name": "mise-en-place",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "backend:install": "cd backend && pnpm install",
    "backend:start": "pnpm --dir backend start",
    "backend:test": "pnpm --dir backend test",
    "frontend:install": "cd frontend && pnpm install",
    "frontend:start": "pnpm --dir frontend start",
    "frontend:build": "pnpm --dir frontend build",
    "frontend:test": "pnpm --dir frontend exec ng test --watch=false",
    "frontend:lint": "pnpm --dir frontend lint"
  }
}
